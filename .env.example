# =============================================================================
# Friopacking · Variables de entorno (ejemplo)
# Copia este archivo a `.env` (local) o configúralo en Vercel → Project Settings
# → Environment Variables. NUNCA subas `.env` con secretos reales al repositorio.
# =============================================================================

# --- WhatsApp Business Cloud API (Nivel 2, opcional) -------------------------
# Sin estas variables, la app funciona con la opción wa.me (Nivel 1).
# Token permanente de la app de WhatsApp (Meta for Developers).
WHATSAPP_TOKEN=

# ID del número de teléfono emisor (Meta WhatsApp Business).
WHATSAPP_PHONE_NUMBER_ID=

# Versión de la Graph API (opcional; por defecto v20.0).
WHATSAPP_API_VERSION=v20.0

# --- Preparado para fases futuras (no requeridas por el MVP) -----------------
# Supabase (persistencia futura)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Base de datos PostgreSQL directa (futuro)
# DATABASE_URL=

# Microsoft 365 / SharePoint / Power BI (integración futura)
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
